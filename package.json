{
  "name": "carepulse-ehr-platform",
  "version": "2.0.0",
  "description": "Enterprise Electronic Health Record System (EHRS) with HL7 v2.5.1 and FHIR R4 Interoperability",
  "scripts": {
    "start": "node server/src/index.js",
    "dev": "node --watch server/src/index.js",
    "start:server": "node server/src/index.js",
    "dev:server": "node --watch server/src/index.js",
    "dev:client": "cd client && npm run dev",
    "build:client": "cd client && npm run build",
    "test": "cd server && npm test"
  },
  "keywords": [
    "ehr",
    "emr",
    "healthcare",
    "fhir-r4",
    "hl7",
    "cpoe",
    "pacs-dicom",
    "soap-notes",
    "react-19",
    "tailwind-v4",
    "nodejs"
  ],
